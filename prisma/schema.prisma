datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DocumentStatus {
  DRAFT
  PENDING
  COMPLETED
}

enum RecipientStatus {
  WAITING
  SIGNED
}

model Document {
  id            String           @id @default(cuid())
  title         String
  originalFile  String           // URL or storage path to original PDF
  completedFile String?          // URL to final flattened signed PDF
  status        DocumentStatus   @default(DRAFT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  recipients    Recipient[]
  fields        SignatureField[]

  @@map("documents")
}

model Recipient {
  id          String          @id @default(cuid())
  documentId  String
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name        String
  email       String
  token       String          @unique @default(cuid()) // Unique token for public /sign/[token] route
  status      RecipientStatus @default(WAITING)
  signedAt    DateTime?

  fields      SignatureField[]

  @@map("recipients")
}

model SignatureField {
  id             String     @id @default(cuid())
  documentId     String
  document       Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipientId    String?
  recipient      Recipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  page           Int
  x              Float      // Percentage relative to page width (0 - 100)
  y              Float      // Percentage relative to page height (0 - 100)
  width          Float      // Percentage relative to page width
  height         Float      // Percentage relative to page height
  label          String?    @default("Signature Line")
  isSigned       Boolean    @default(false)
  signatureValue String?    @db.Text // Base64 charcoal PNG string

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("signature_fields")
}